Panels:
  - Class: rviz_common/Displays
    Help Height: 140
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Octomap1
        - /Bounds1
        - /Bounds1/Namespaces1
        - /Dynamic Obstacles Ground Truth1/Namespaces1
        - /Frontiers and RRT (Local Planner)1
        - /Frontiers and RRT (Local Planner)1/Namespaces1
        - /PointCloud21/Topic1
        - /TF1/Frames1
        - /Path (Local RRT)1/Topic1
        - /Pedestrian1/Topic1
        - /Covariance Ellipse1/Topic1
        - /Global Planner (Best path and Chosen Frontier)1/Namespaces1
        - /RRT* (Edges)1/Topic1
        - /Map1/Topic1
        - /Map1/Position1
      Splitter Ratio: 0.4808153510093689
    Tree Height: 989
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
      - /2D Pose Estimate1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""

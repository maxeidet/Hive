<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="hive_base">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.8 0.8 0.8</ambient>
      <background>0.5 0.7 0.9</background>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- Gräsmarken -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
          <material>
            <ambient>0.2 0.4 0.2 1</ambient>
            <diffuse>0.2 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- HIVE HELIPAD (Drönarens startplats i mitten, 0,0) -->
    <model name="helipad">
      <pose>0 0 0.05 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4 4 0.1</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================== -->
    <!-- FORTIFIERAD BAS - BYGGD MED ROBUSTA MODELLER -->
    <!-- ============================================== -->

    <!-- PERIMETER-MURAR (40x40 meter bas) -->
    <model name="wall_north">
      <pose>0 20 2 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>40 1 4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>40 1 4</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
      </link>
    </model>
    
    <model name="wall_east">
      <pose>20 0 2 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 40 4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 40 4</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
      </link>
    </model>

    <model name="wall_west">
      <pose>-20 0 2 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 40 4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 40 4</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
      </link>
    </model>

    <!-- Södra muren med en 8 meter bred ingång -->
    <model name="wall_south_left">
      <pose>-14 -20 2 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 1 4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 1 4</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
      </link>
    </model>
    <model name="wall_south_right">
      <pose>14 -20 2 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 1 4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 1 4</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
      </link>
    </model>

    <!-- 4x VAKTTORN I HÖRNEN -->
    <model name="tower_ne"><pose>20 20 3 0 0 0</pose><static>true</static><link name="link"><visual name="visual"><geometry><box><size>2 2 6</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual><collision name="collision"><geometry><box><size>2 2 6</size></box></geometry></collision></link></model>
    <model name="tower_nw"><pose>-20 20 3 0 0 0</pose><static>true</static><link name="link"><visual name="visual"><geometry><box><size>2 2 6</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual><collision name="collision"><geometry><box><size>2 2 6</size></box></geometry></collision></link></model>
    <model name="tower_se"><pose>20 -20 3 0 0 0</pose><static>true</static><link name="link"><visual name="visual"><geometry><box><size>2 2 6</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual><collision name="collision"><geometry><box><size>2 2 6</size></box></geometry></collision></link></model>
    <model name="tower_sw"><pose>-20 -20 3 0 0 0</pose><static>true</static><link name="link"><visual name="visual"><geometry><box><size>2 2 6</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual><collision name="collision"><geometry><box><size>2 2 6</size></box></geometry></collision></link></model>

    <!-- KOMMANDOCENTRAL / BUNKER INUTI BASEN -->
    <model name="bunker">
      <pose>-8 8 2.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 10 5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 10 5</size></box></geometry><material><ambient>0.4 0.45 0.4 1</ambient></material></visual>
      </link>
    </model>
    
    <!-- Radartorn på Bunkern -->
    <model name="radar">
      <pose>-8 8 6 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual"><geometry><cylinder><radius>2</radius><length>2</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 1</ambient></material></visual>
      </link>
    </model>

    <!-- ZIG-ZAG KONTROLLSTATION VID ENTRÉN MED JERSEY BARRIERS -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey barrier</uri>
      <name>barrier_1</name>
      <pose>4 -18 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey barrier</uri>
      <name>barrier_2</name>
      <pose>-4 -22 0 0 0 0</pose>
    </include>

    <!-- PATRULLFORDON (Pickups som vi vet fungerar) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
      <name>truck_1</name>
      <pose>10 -10 0 0 0 3.14</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
      <name>truck_2</name>
      <pose>14 -10 0 0 0 3.14</pose>
    </include>

  </world>
</sdf>
